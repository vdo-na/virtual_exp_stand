{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "CPU & Memory Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "showPoints": "never", "spanNulls": false },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "docker_container_cpu_usage_percent{container_name!~\"monitoring.*\"}",
          "legendFormat": "{{container_name}}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage per Container (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "showPoints": "never", "spanNulls": false },
          "unit": "decmbytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "docker_container_mem_usage{container_name!~\"monitoring.*\"} / 1024 / 1024",
          "legendFormat": "{{container_name}}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage per Container (MB)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Network & Limits",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "showPoints": "never" },
          "unit": "binBps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } },
      "targets": [
        {
          "expr": "rate(docker_container_net_rx_bytes{container_name!~\"monitoring.*\"}[30s])",
          "legendFormat": "{{container_name}} (Rx)",
          "refId": "A"
        },
        {
          "expr": "rate(docker_container_net_tx_bytes{container_name!~\"monitoring.*\"}[30s])",
          "legendFormat": "{{container_name}} (Tx)",
          "refId": "B"
        }
      ],
      "title": "Network Traffic (In / Out)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "showPoints": "never" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } },
      "targets": [
        {
          "expr": "docker_container_mem_usage_percent{container_name!~\"monitoring.*\"}",
          "legendFormat": "{{container_name}} Limit %",
          "refId": "A"
        }
      ],
      "title": "Memory Limit Utilization (%)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["docker", "telegraf"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Docker Containers Workload Monitor"
}